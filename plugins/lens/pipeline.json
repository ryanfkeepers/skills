{
  "retries": 1,
  "max_agents": 32,
  "init": [
    {"name": "graph-core", "scope": "code", "gate": "none", "implemented": true},
    {"name": "conventions", "scope": "core", "gate": "approve", "implemented": true, "reuse_core": "conventions"},
    {"name": "contract-layers", "scope": "core", "gate": "approve", "implemented": true, "reuse_core": "contract-layers"}
  ],
  "lenses": [
    {"name": "intake", "scope": "run", "gate": "qa", "implemented": true},
    {"name": "workspace", "scope": "code", "gate": "qa", "implemented": true},
    {"name": "graph", "scope": "code", "gate": "none", "implemented": true},
    {"name": "explore", "scope": "run", "gate": "none", "implemented": true},
    {"name": "design", "scope": "run", "gate": "qa", "implemented": true},
    {"name": "design-trim", "scope": "run", "gate": "qa", "implemented": true},
    {"name": "visualize-design", "scope": "run", "gate": "go-ahead", "implemented": true},
    {"name": "plan", "scope": "run", "gate": "none", "implemented": true},
    {"name": "build", "scope": "grid", "gate": "none", "implemented": true,
     "cells": ["scaffold", "implement", "unit-test", "test-coverage"]},
    {"name": "green", "scope": "run", "gate": "none", "implemented": true},
    {"name": "test-negative-catch-1", "agent": "test-negative-catch", "scope": "run", "gate": "none", "implemented": true,
     "only_for": ["fix"]},
    {"name": "review-select", "scope": "run", "gate": "none", "implemented": true},
    {"name": "review-1", "scope": "settle", "gate": "qa", "implemented": true,
     "always": ["review-correctness", "review-conventions"],
     "lenses": ["review-correctness", "review-failure-modes", "review-concurrency",
                "review-conventions", "review-reuse-helpers",
                "review-integration-correctness", "review-blast-radius",
                "review-error-contract", "review-security", "review-performance",
                "review-conformance"]},
    {"name": "review-2", "scope": "settle", "gate": "qa", "implemented": true,
     "lenses": ["lint", "code-trim", "decoherence", "adversarial-review"]},
    {"name": "pseudolinter", "scope": "run", "gate": "none", "implemented": true},
    {"name": "vibediff", "scope": "run", "gate": "go-ahead", "implemented": true},
    {"name": "visualize-changes", "scope": "run", "gate": "go-ahead", "implemented": true},
    {"name": "docs-comments", "scope": "parallel", "gate": "qa", "implemented": true,
     "lenses": ["docs", "comments"]},
    {"name": "scenarios", "scope": "run", "gate": "approve", "implemented": true},
    {"name": "test-2", "scope": "settle", "gate": "qa", "implemented": true,
     "lenses": ["contract-test", "integration-test", "e2e-test"],
     "per_boundary": ["contract-test"], "writers": true},
    {"name": "test-negative-catch-2", "agent": "test-negative-catch", "scope": "run", "gate": "none", "implemented": true,
     "only_for": ["fix"]},
    {"name": "ticket", "scope": "run", "gate": "qa", "implemented": true},
    {"name": "stack-shape", "scope": "run", "gate": "none", "implemented": true},
    {"name": "describe", "scope": "parallel", "gate": "none", "implemented": true,
     "lenses": ["describe"], "per_slice": true},
    {"name": "apply-descriptions", "scope": "code", "gate": "none", "implemented": true},
    {"name": "publish", "scope": "run", "gate": "none", "implemented": true},
    {"name": "pr-wait-1", "scope": "sleep", "seconds": 300, "gate": "none", "implemented": true},
    {"name": "pr-followup-1", "agent": "pr-followup", "scope": "run", "gate": "qa", "implemented": true},
    {"name": "pr-wait-2", "scope": "sleep", "seconds": 300, "gate": "none", "implemented": true},
    {"name": "pr-followup-2", "agent": "pr-followup", "scope": "run", "gate": "qa", "implemented": true},
    {"name": "run-report", "scope": "code", "gate": "none", "implemented": true},
    {"name": "cleanup", "scope": "code", "gate": "none", "implemented": true}
  ]
}
